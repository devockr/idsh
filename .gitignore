# Local dsh state, written at runtime (see README).
.dsh
# pnpm workspace install for the companion plugins under packages/.
node_modules

# The real compose file is the machine-specific copy; the tracked template is
# docker-compose.example.yml. Hostnames, LAN addresses and proxy settings in it
# are not meant to be published.
docker-compose.yml
# Local secrets per the README (PUID / PGID).
.env
# Never commit private keys that happen to land in the working tree.
id_rsa
id_ed25519
# build output of the packages (the images ship lib/, the repo does not)
packages/*/lib/
# test coverage, when a run writes it
coverage/

# eslint --cache output
.eslintcache

# The docs site's build output
dist/
