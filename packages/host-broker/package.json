{
  "name": "@idsh/host-broker",
  "version": "0.0.0",
  "type": "module",
  "description": "The host-side half of @idsh/host-ops: a typed, audited operation table on a unix socket, so the container never holds a host credential",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devockr/idsh.git",
    "directory": "packages/host-broker"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "idsh-host": "lib/cli.js"
  },
  "main": "lib/broker.js",
  "exports": {
    ".": {
      "default": "./lib/broker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "host",
    "broker",
    "unix-socket",
    "diagnostics"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
