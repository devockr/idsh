{
  "name": "idsh",
  "type": "module",
  "description": "Companion dsh plugins for the container image in this repository",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "deploy:dev": "pnpm dev && node tools/dev/deploy-dev.ts",
    "deploy:dev:dry": "node tools/dev/deploy-dev.ts --dry",
    "dev": "pnpm build && docker build --target base -t devockr/idsh:base . && docker build -f Dockerfile.dev -t devockr/idsh:dev .",
    "docs:build": "vite build",
    "docs:dev": "vite",
    "fix": "concurrently 'pnpm:lint:ox --fix' 'pnpm:lint:es --fix'",
    "format": "concurrently 'pnpm:format:base:* --write'",
    "format:base:oxfmt": "oxfmt --ignore-path .gitignore .",
    "format:base:prettier": "prettier .",
    "format:check": "concurrently 'pnpm:format:base:* --check'",
    "lint": "concurrently 'pnpm:lint:*'",
    "lint:es": "eslint --flag unstable_native_nodejs_ts_config . --cache",
    "lint:ox": "oxlint .",
    "lint:tsc": "tsc -p tsconfig.json",
    "pack": "pnpm --recursive pack",
    "release": "changeset publish",
    "test": "pnpm --recursive --if-present run test",
    "typecov": "type-coverage",
    "version": "changeset version && node tools/sync-image-pins.mts && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@1stg/eslint-config": "^12.0.1",
    "@1stg/markuplint-config": "^6.0.0",
    "@1stg/oxfmt-config": "^1.1.0",
    "@1stg/oxlint-config": "^1.1.0",
    "@1stg/prettier-config": "^7.0.0",
    "@1stg/tsconfig": "^5.1.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.5.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.0",
    "eslint": "^10.12.0",
    "github-markdown-css": "^5.9.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-sh": "^0.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "type-coverage": "^2.29.7",
    "typed-query-selector": "^2.12.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "typeCoverage": {
    "atLeast": 99,
    "cache": true,
    "detail": true,
    "ignoreCatch": true,
    "ignoreFiles": "*.d.ts",
    "ignoreNonNullAssertion": true,
    "strict": true
  }
}
