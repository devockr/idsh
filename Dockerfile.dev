# The dev image: everything the published image is built from, plus the browsers' shared
# libraries. It is a separate file on purpose — the deployment build must never
# pick these up by accident — and it is built from Dockerfile's `base` target instead of the
# published image, so it does not depend on the plugins being published.
#
#   pnpm dev
#
# which compiles the packages and then builds `:base` and `:dev` in that order — `:base` carries
# `tools/` and `entrypoint.sh`, and the compiled `lib/` is what the profile links to, so neither
# step can be skipped or swapped.
#
# Then run a browser-driven check in it, sharing the deployment's state and network namespace
# so it can reach the running GUI on 127.0.0.1. `--entrypoint` is required: without it the
# image's own entrypoint reads the command as dsh arguments and boots a second server
# instead. `--user` matches the deployment's, so nothing it writes into the mounts is owned
# by root. The checkout is mounted explicitly — the default compose file mounts only dsh's
# state, so `--volumes-from dsh` alone would not carry the script:
#
#   docker run --rm --network container:dsh --volumes-from dsh --user "$UID:$GID" \
#     --entrypoint node -v "$PWD:/checkout" -w /checkout \
#     devockr/idsh:dev <check>.mjs
#
# The browser itself is in neither image: it lives in the mounted cache
# (~/.dsh/cache/ms-playwright), populated once with `pnpm exec playwright install`.
#
# The list below is measured with `ldd` against both binaries, not copied from
# `playwright install-deps chromium` — that one also serves headed Chromium, so it adds xvfb,
# five font packages and xfonts-scalable. The headless shell asks for 21 sonames; the full
# Chromium in `chromium-*/chrome-linux64` asks for three more (libcups2, libcairo2,
# libpango-1.0-0).
#
# The nine shell names cover those 21: the rest are hard dependencies of them (libx11-6,
# libxext6, libxcb1, libglib2.0-0, libexpat1, libdbus-1-3, libnspr4, libatk1.0-0,
# libatspi2.0-0). libxfixes3 is explicit because nothing in bookworm depends on it; the
# Chromium three bring their own chain (harfbuzz, fribidi, thai, pixman, xcb-render/shm,
# avahi). There is no Debian meta-package for this set: the one-name shortcuts are both
# heavier and incomplete (`chromium` drags a whole browser, `libgtk-3-0` drags GTK + pango +
# cairo and still misses nss/nspr/asound/gbm). fonts-liberation and fontconfig's
# configuration are here because Skia aborts the renderer the first time a page shapes text,
# which is every page. Headed runs would need the X/GTK set and an X server as well; nothing
# here installs one.
ARG BASE=devockr/idsh:base

# The broker's client image. The default is the local build the dev workflow makes
# (`docker build --target client -t code-vaults/gcb-client:dev .` in the broker's checkout); a
# user without that checkout can point it at a published one instead
# (`--build-arg GCB_CLIENT_IMAGE=ghcr.io/code-vaults/gcb-client:<tag>`), which is what makes the
# dev image buildable from this repository alone. A stage of its own, because `COPY --from` takes
# a stage name here rather than a variable.
ARG GCB_CLIENT_IMAGE=code-vaults/gcb-client:dev
FROM ${GCB_CLIENT_IMAGE} AS gcb-client

FROM ${BASE}

# An ARG before FROM is only usable in the FROM line, so the registry has to be declared again.
ARG NPM_REGISTRY=https://registry.npmmirror.com/

# The apt sources are the base image's, already rewritten to its `APT_MIRROR` — so this stage
# installs from the same mirror without an argument of its own. A build that wants another mirror
# passes it to the base, not here.
# The base image already dropped `docker-clean` and set `keep-cache`, and both are image layers,
# so this stage only installs: the two cache mounts are what keeps the archives between builds.
RUN --mount=type=cache,id=apt_cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,id=apt_lists,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  libatk-bridge2.0-0 libgbm1 libxrandr2 libxcomposite1 libxdamage1 libxfixes3 \
  libxkbcommon0 libnss3 libasound2 fonts-liberation fontconfig \
  libcups2 libcairo2 libpango-1.0-0

# Node 26 ships without Corepack. The dev image carries it so a checkout's `packageManager`
# selects the tool version instead of whatever happens to be installed; the pinned pnpm is
# prepared into COREPACK_HOME at build time, so a boot that runs pnpm before the network is up
# does not download it. Keep the version in step with package.json's `packageManager`.
#
# The cache lives under the runtime user's home: entrypoint.sh re-points the `app` account at
# PUID/PGID, so no owner chosen at build time can match it. The tree is left writable, which is
# what lets that user refresh or add a version while the prepared entries stay executable.
ENV COREPACK_HOME=/home/app/.cache/node/corepack
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
RUN npm install -g corepack@0.36.0 --force --registry="$NPM_REGISTRY" \
  && corepack enable \
  && mkdir -p "$COREPACK_HOME" \
  && corepack prepare pnpm@12.18.0 --activate \
  && chmod -R a+rwX /home/app/.cache

# The same baked profile as the published image, from this checkout instead of the registry, and
# as a `link:` rather than a copy: a deployment may mount a built checkout over
# /opt/dsh/packages instead, and then its edits need no image build at all.
# The packages are TypeScript and compiled from src/ by `pnpm build` before this image is built:
# that lib/ is what dsh loads, a fresh checkout has none until it has run, so it is checked here
# rather than discovered at runtime. `--chmod` is not decoration either — COPY takes the modes from
# the build context, so a builder with a strict umask would ship the sources 0600 root:root.
# The broker's client comes from the stage named above — its own checkout's dev image, or the
# published one a builder names through GCB_CLIENT_IMAGE — not from npm: the dev overlay is where
# a gcb change is exercised against idsh. `base` carries no client at all (the published stage installs it), so the copy is
# the only one here; `/usr/local/bin/gcb` is created below and points into the copied package.
COPY --from=gcb-client /usr/local/lib/node_modules/gcb-client /usr/local/lib/node_modules/gcb-client
COPY --from=gcb-client /usr/local/lib/node_modules/gcb-core /usr/local/lib/node_modules/gcb-core
RUN ln -sf ../lib/node_modules/gcb-client/bin/gcb.js /usr/local/bin/gcb && gcb --version

COPY --chmod=755 packages/ /opt/dsh/packages/
RUN set -e; for d in /opt/dsh/packages/*/; do \
      [ -f "${d}package.json" ] || continue; \
      grep -q '"main"' "${d}package.json" || continue; \
      [ -f "${d}lib/index.js" ] || { echo "no ${d}lib/index.js — run pnpm build first" >&2; exit 1; }; \
      [ -f "${d}src/client.ts" ] && [ ! -f "${d}lib/client.js" ] && { echo "no ${d}lib/client.js — run pnpm build first" >&2; exit 1; }; \
      stamp="$(ls -t "${d}"*.tsbuildinfo 2>/dev/null | head -1)"; \
      [ -n "${stamp}" ] || { echo "no ${d}*.tsbuildinfo — run pnpm build first" >&2; exit 1; }; \
      [ -z "$(find "${d}src" -name '*.ts' -newer "${stamp}" -print -quit)" ] \
        || { echo "${d}src is newer than ${d}$(basename "${stamp}") — run pnpm build" >&2; exit 1; }; \
    done

RUN set -e; mkdir -p /opt/dsh/home \
 && export HOME=/opt/dsh/home \
 && printf 'registry=%s\n' "$NPM_REGISTRY" > "$HOME/.npmrc" \
 && dsh web --dump-config >/dev/null \
 && for d in /opt/dsh/packages/*/; do \
      [ -f "${d}package.json" ] && node -e "process.exit(require('${d}package.json').dsh ? 0 : 1)" || continue; \
      dsh plugin --profile web add "link:${d%/}"; \
    done \
 && test -f /opt/dsh/home/.dsh/profiles/web/package.json

# The dev tools, after everything above: the base stage carries only the one script the entrypoint
# runs, so that adding a helper does not invalidate its npm install and the apt layer above this one.
# Only tools/dev/ comes along — the checks and the release scripts are for CI, not for the image —
# and it lands last so a change there does not redo the profile baking either.
COPY --chmod=755 tools/dev /opt/dsh/tools/
