{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "checkJs": true
  },
  "include": ["tools", "vite.config.ts", "eslint.config.mjs", "oxlint.config.ts", "oxfmt.config.ts"]
}
